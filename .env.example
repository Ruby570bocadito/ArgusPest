# ─────────────────────────────────────────────────────────────────
# Argos — Variables de entorno
# Copiar a .env y completar valores reales
# ─────────────────────────────────────────────────────────────────

# ── C2 Server ─────────────────────────────────────────────────────
ARGOS_C2_HOST=0.0.0.0
ARGOS_C2_GRPC_PORT=50051
ARGOS_C2_HTTP_PORT=8443
ARGOS_TLS=false

# ── Metasploit (opcional) ─────────────────────────────────────────
ARGOS_MSF_HOST=127.0.0.1
ARGOS_MSF_PORT=55553
ARGOS_MSF_PASSWORD=changeme

# ── CTFd (opcional) ───────────────────────────────────────────────
ARGOS_CTFD_URL=https://ctf.example.com
ARGOS_CTFD_TOKEN=your_api_token_here

# ── Dashboard JWT ─────────────────────────────────────────────────
ARGOS_JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_32_CHARS_MIN

# ── Database ──────────────────────────────────────────────────────
ARGOS_DB_PATH=./data/argos.db
ARGOS_QDRANT_PATH=./data/qdrant

# ── Logging ───────────────────────────────────────────────────────
ARGOS_LOG_LEVEL=INFO
